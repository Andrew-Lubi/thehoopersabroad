// Cloudflare Workers config: a small sign-in script (worker/index.js) in front of a plain static site (no build step).
{
  "name": "thehoopersabroad",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
